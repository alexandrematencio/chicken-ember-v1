{
  "name": "website",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "rm -rf .output dist",
    "predeploy": "npm run clean && NUXT_APP_BASE_URL=/chicken-ember-v1/ nuxt generate && touch .output/public/.nojekyll",
    "deploy": "gh-pages -d .output/public --dotfiles -m \"chore(deploy): publish static export\""
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "nuxt": "^4.4.8",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/archivo": "^5.2.8",
    "gh-pages": "^6.3.0",
    "puppeteer-core": "^25.1.0",
    "sharp": "^0.35.0"
  }
}
